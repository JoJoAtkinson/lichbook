#!/bin/bash
# lich — keep a MacBook awake with the lid closed, but ONLY while it is
# plugged in AND you are logged in. Unplug it, log out, or lay it to rest,
# and it sleeps like any mortal machine.
#
# The lore is the spec: the power cord is the phylactery. While it feeds the
# machine, the lich stays risen — lid open or closed. Sever the phylactery
# (unplug), or let the soul depart (log out), and the body returns to rest.
#
# How it works, in one paragraph:
#   `lich install` loads a per-user LaunchAgent that runs `lich watch`.
#   Every 5 seconds the watcher reads the risen/at-rest flag in
#   ~/.lich/desired-state and the power source, and flips the hidden
#   `pmset disablesleep` setting: 1 when risen AND (on AC power OR roaming)
#   (lid-close no longer sleeps), 0 otherwise. `lich on|off` just writes the
#   flag — so anything that can write a file (the menu bar app, the Control
#   Center toggle, an ssh session) can control it. Because the watcher is a
#   per-user LaunchAgent it only exists while you're logged in — at logout
#   launchd sends SIGTERM and the cleanup trap re-enables normal sleep.
#
#   Roaming (~/.lich/roam) is the deliberate exception to "no cord, no lich":
#   staying risen on battery for one trip, for a timer, or always — always
#   under a battery floor (~/.lich/config) that outranks every mode and every
#   caller. The same tick that reconciles power expires timers, spends
#   one-shots and enforces the floor, so a roam ends within ~5 seconds of the
#   condition that ends it.
#
# Read this before you grant sudo (then read the rest — it's one short file):
#   * The passwordless sudoers rule installed here permits exactly two command
#     lines and nothing else: `pmset -a disablesleep 0` and
#     `pmset -a disablesleep 1`. That is the entire standing privilege.
#   * Nothing runs as root. The watcher is a per-user LaunchAgent running as
#     you; it borrows root only for that one setting. `install`/`uninstall`
#     use ordinary *prompted* sudo to place and remove their own files —
#     that's the one password prompt.
#   * Every `sudo -n` below means "never prompt", deliberately: a background
#     watcher must fail loudly, not hang on a prompt nobody can see.
#
# Inspired by: tmad4000/nosleep (scoped sudoers, cleanup traps),
# Moarram/wake (minimal pmset wrapping), hizzt/mac-sleep-tool
# (power-event-driven LaunchAgent — plus fixing its missing logout reset).

set -euo pipefail

# Everything lich touches, in one place. `lich uninstall` removes all of it
# except the log, which it leaves for you to read.
LABEL="com.lichbook.watcher"
CLI_LINK="/usr/local/bin/lich"     # only created if lich isn't already on PATH
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
SUDOERS="/etc/sudoers.d/lichbook"
LOG_FILE="$HOME/Library/Logs/lich.log"
STATE_DIR="$HOME/.lich"            # sandboxed Control Center widget writes here
FLAG="$STATE_DIR/desired-state"    # contents: "on" (risen) or "off" (at rest)
ROAM="$STATE_DIR/roam"             # "off" | "once" | "always" | "until <epoch>"
CONFIG="$STATE_DIR/config"         # key=value lines: floor, roam_mins
PMSET="/usr/bin/pmset"             # absolute: the sudoers rule matches this
                                   # exact string, so every caller must too
POLL_INTERVAL=5   # seconds between checks; the worst-case delay for a flag
                  # flip or plug/unplug to take effect

# Roaming defaults, used whenever ~/.lich/config is missing or says nothing
# about a key. The floor is the one number that overrules the user: below it
# roaming ends, always-mode included. A machine that runs itself flat in a bag
# is a worse tool than one that sleeps, so there is no override flag.
DEFAULT_FLOOR=20        # percent
DEFAULT_ROAM_MINS=30    # minutes, for `lich roam timer`

# Watcher memory — meaningful only inside the `watch` loop, where the process
# lives for the whole session. Deliberately not persisted: a watcher restart
# forgetting these is acceptable (worst case, an armed one-shot survives one
# extra plug-in, and a suspension is logged twice).
ROAM_GRANTED_ON_BATTERY=0   # a "once" roam actually held the Mac awake off AC
FLOOR_SUSPEND_LOGGED=0      # always-mode floor suspension: log once, not 12/min
BATTERY_UNREADABLE_LOGGED=0 # ditto for an unparsable battery reading
BATTERY_PCT=100             # last reading; set by read_battery, never read raw

# Every log line goes to $LOG_FILE directly, no matter who called — watcher,
# CLI, menu bar app (which discards CLI output), Control-Center-triggered
# ticks. That makes the log a complete, timestamped history of every state
# transition, usable as evidence when marking docs/STATE-TABLE.md rows Tested.
# Terminal echo only when interactive; under launchd stdout is already the
# log file and echoing would double every line.
log() {
  local line
  line="$(printf '%s %s' "$(date '+%Y-%m-%d %H:%M:%S')" "$*")"
  { mkdir -p "$(dirname "$LOG_FILE")" && printf '%s\n' "$line" >> "$LOG_FILE"; } 2>/dev/null || true
  [[ -t 1 ]] && printf '%s\n' "$line"
  return 0
}
# Same, but the interactive echo goes to stderr — stdout stays clean for the
# machine-readable commands (`roam status`, `config`).
log_warn() {
  local line
  line="$(printf '%s %s' "$(date '+%Y-%m-%d %H:%M:%S')" "$*")"
  { mkdir -p "$(dirname "$LOG_FILE")" && printf '%s\n' "$line" >> "$LOG_FILE"; } 2>/dev/null || true
  [[ -t 2 ]] && printf '%s\n' "$line" >&2
  return 0
}
die() { echo "lich: $*" >&2; exit 1; }

# ---------- state probes ----------------------------------------------------
# All read-only. Nothing in this section needs privileges.

# Line 1 of `pmset -g ps` names the live source: "'AC Power'" / "'Battery Power'".
on_ac() { "$PMSET" -g ps | head -1 | grep -q "AC Power"; }

power_source() { on_ac && echo "AC (phylactery intact)" || echo "battery"; }

# What you asked for. A missing or unreadable flag reads as at rest, so the
# safe answer is always the default one.
risen() { [[ "$(cat "$FLAG" 2>/dev/null)" == "on" ]]; }

# The first percentage `pmset -g batt` prints — the internal battery's charge —
# left in $BATTERY_PCT. Anything we can't parse (a desktop Mac, an unexpected
# format) reads as 100: fail toward staying awake, exactly like every other
# probe here, and say so in the log the first time.
#
# It sets a variable instead of printing one because a `$(...)` caller runs it
# in a subshell, where the "log this once" latch would be thrown away with the
# subshell and the watcher would repeat the warning twelve times a minute.
read_battery() {
  local p
  p="$("$PMSET" -g batt 2>/dev/null | grep -o '[0-9][0-9]*%' | head -1 | tr -d '%' || true)"
  if [[ "$p" =~ ^[0-9]+$ ]]; then
    BATTERY_PCT="$p"
  else
    BATTERY_PCT=100
    if [[ "$BATTERY_UNREADABLE_LOGGED" == 0 ]]; then
      log_warn "WARNING: cannot read battery percentage from 'pmset -g batt' — assuming 100%"
      BATTERY_UNREADABLE_LOGGED=1
    fi
  fi
}

# ~/.lich/config, one key=value per line. Deliberately dumb: no arrays (bash
# 3.2 has none), last assignment wins, surrounding whitespace trimmed, and
# anything that isn't a plain integer — junk value, unknown key, missing file —
# falls back to the default rather than failing.
config_get() {
  local key="$1" def="$2" v=""
  if [[ -f "$CONFIG" ]]; then
    v="$(awk -F= -v k="$key" '
          NF < 2 { next }
          { name = $1; val = $2
            gsub(/^[ \t]+|[ \t]+$/, "", name)
            gsub(/^[ \t]+|[ \t]+$/, "", val)
            if (name == k) out = val }
          END { print out }' "$CONFIG" 2>/dev/null || true)"
  fi
  [[ "$v" =~ ^[0-9]+$ ]] || v="$def"
  echo "$v"
}

# Rewrite one key, leaving every other line (including keys we don't know)
# alone. Temp file in the same directory so the replace is an atomic rename —
# the watcher reads this file every tick and must never see half of it.
config_set() {
  local key="$1" val="$2" tmp
  mkdir -p "$STATE_DIR"
  tmp="$STATE_DIR/.config.$$"
  : > "$tmp"
  if [[ -f "$CONFIG" ]]; then
    grep -v "^[[:space:]]*${key}[[:space:]]*=" "$CONFIG" >> "$tmp" || true
  fi
  printf '%s=%s\n' "$key" "$val" >> "$tmp"
  mv "$tmp" "$CONFIG"
}

# ---------- roaming --------------------------------------------------------
# Roaming is staying risen without the phylactery: awake on battery, because
# you said so, until the trip ends or the floor calls the loan. One file, one
# value — arming a mode replaces whatever was there, so the three modes are
# mutually exclusive for free.

# Raw contents, first line only. Missing file = off, which is the state a Mac
# that has never heard of roaming should be in.
roam_mode() {
  local m
  m="$(head -1 "$ROAM" 2>/dev/null || true)"
  m="${m#"${m%%[![:space:]]*}"}"   # trim leading whitespace
  m="${m%"${m##*[![:space:]]}"}"   # trim trailing whitespace
  [[ -n "$m" ]] || m="off"
  echo "$m"
}

# Write-then-rename, so a tick that reads this file in the same instant sees
# the old value or the new one and never an empty file — an empty read means
# "off", which on battery with the lid shut would sleep the Mac mid-roam.
roam_set() {
  local tmp
  mkdir -p "$STATE_DIR"
  tmp="$STATE_DIR/.roam.$$"
  printf '%s\n' "$1" > "$tmp"
  mv "$tmp" "$ROAM"
}

# The mode as a reader should see it: same four values as the file, except an
# elapsed timer and anything unrecognized report "off". Pure — no writes, no
# log lines — because `lich roam status` is parsed by the menu bar app and
# `lich status` must stay read-only. Clearing an expired timer is the
# watcher's job, and only the watcher's, so the log gets exactly one line
# about it.
roam_state() {
  local mode epoch
  mode="$(roam_mode)"
  case "$mode" in
    once|always) echo "$mode" ;;
    'until '*)
      epoch="${mode#until }"
      if [[ "$epoch" =~ ^[0-9]+$ ]] && [[ "$(date +%s)" -lt "$epoch" ]]; then
        echo "until $epoch"
      else
        echo off
      fi
      ;;
    *) echo off ;;
  esac
}

# Roaming in English, for `lich status`. Same pure read as roam_state.
roam_human() {
  local state epoch left
  state="$(roam_state)"
  case "$state" in
    once)   echo "once — stays risen unplugged, until you plug back in" ;;
    always) echo "always — stays risen unplugged" ;;
    'until '*)
      epoch="${state#until }"
      left=$(( ( epoch - $(date +%s) + 59 ) / 60 ))   # round up: 0 min left
      [[ "$left" -lt 1 ]] && left=1                   # reads as expired
      echo "$left min left — stays risen unplugged"
      ;;
    *) echo "off — unplugged means sleep" ;;
  esac
}

# The watcher's question, asked only on battery (on AC the answer doesn't
# matter — the phylactery already keeps the lich up). Unlike everything above
# this one is allowed to write: expiry, floor breach and their log lines are
# state changes the watcher owns.
roam_active() {
  local mode floor epoch
  mode="$(roam_mode)"
  [[ "$mode" == "off" ]] && return 1

  # The floor outranks every mode, always-mode included. A once/timed roam
  # that hits it is spent — cleared, so nothing silently resumes at 19%. An
  # always-mode roam is only suspended: it is a standing preference, not a
  # trip, and it must survive to the next charge.
  floor="$(config_get floor "$DEFAULT_FLOOR")"
  read_battery
  if [[ "$BATTERY_PCT" -le "$floor" ]]; then
    case "$mode" in
      always)
        if [[ "$FLOOR_SUSPEND_LOGGED" == 0 ]]; then
          log "battery floor ${floor}% — roam suspended (always-mode kept)"
          FLOOR_SUSPEND_LOGGED=1
        fi
        ;;
      *)
        roam_set off
        log "battery floor ${floor}% — roam canceled"
        ;;
    esac
    return 1
  fi

  case "$mode" in
    once)
      # Remember that the grant did real work, so the return of the
      # phylactery can spend it. In-memory on purpose (see the top of file).
      ROAM_GRANTED_ON_BATTERY=1
      return 0
      ;;
    always) return 0 ;;
    'until '*)
      epoch="${mode#until }"
      if [[ "$epoch" =~ ^[0-9]+$ ]] && [[ "$(date +%s)" -lt "$epoch" ]]; then
        return 0
      fi
      roam_set off
      log "roam timer expired"
      return 1
      ;;
    *)
      # Unrecognized contents. Treat as off — same posture as the risen flag,
      # where only the exact expected string counts.
      return 1
      ;;
  esac
}

# What the tick has to do about roaming when the cord is back: spend a
# one-shot that was actually used, and re-arm the once-per-session suspension
# notice. Only ever called with AC present.
roam_on_ac() {
  if [[ "$ROAM_GRANTED_ON_BATTERY" == 1 && "$(roam_mode)" == "once" ]]; then
    roam_set off
    log "phylactery restored — one-shot roam spent"
  fi
  ROAM_GRANTED_ON_BATTERY=0
  FLOOR_SUSPEND_LOGGED=0
}

# ---------- more state probes ----------------------------------------------

# What the kernel actually has set — not necessarily what we last asked for
# (a reboot, a crash, another tool). Ground truth for reconcile.
sleep_disabled() {
  local v
  v="$("$PMSET" -g | awk '/SleepDisabled/ {print $2}')"
  echo "${v:-0}"
}

watcher_running() { launchctl print "gui/$UID/$LABEL" >/dev/null 2>&1; }

lid_closed() { ioreg -r -k AppleClamshellState -d 1 2>/dev/null | grep -q '"AppleClamshellState" = Yes'; }

console_locked() { ioreg -n Root -d1 -a 2>/dev/null | plutil -p - 2>/dev/null | grep -q '"IOConsoleLocked" => true'; }

# Locking = starting the screensaver, which arms the system's own
# "require password after screensaver/display off" setting. No accessibility
# or automation permission needed, and it works with the lid already shut.
lock_console() { open -a ScreenSaverEngine 2>/dev/null || true; }

# ---------- watcher (runs under launchd; not meant to be called by hand) ----

# The entire policy: disablesleep is 1 only when you have raised the lich AND
# (the phylactery is intact OR you asked to roam without it). Idempotent —
# compares desired against live and calls sudo only on a difference, so the
# 5-second loop stays silent until something actually changes.
#
# Order matters. roam_active is asked only on battery, both because on AC the
# answer is irrelevant and because asking it is what expires timers and
# enforces the floor — work that belongs to a tick that is actually running on
# battery. The AC branch does the mirror-image bookkeeping: spending a
# one-shot the moment the cord comes back.
reconcile() {
  local want=0 roam=off
  if on_ac; then
    roam_on_ac
    if risen; then want=1; fi
  elif risen && roam_active; then
    want=1
  fi
  [[ "$(sleep_disabled)" == "$want" ]] && return 0
  roam="$(roam_state)"
  if sudo -n "$PMSET" -a disablesleep "$want" 2>/dev/null; then
    log "risen=$(risen && echo yes || echo no) power=$(power_source) roam=$roam -> disablesleep=$want"
  else
    # Refused, and -n means we never hung on a prompt to find out. Don't spin
    # silently: die and let the log say why.
    log "ERROR: 'sudo pmset' refused — sudoers rule missing? Run: lich install"
    return 78   # EX_CONFIG; the watcher exits on it, interactive callers don't
  fi
}

cleanup() {
  # Runs on ANY exit — normal, error, Ctrl-C, and the SIGTERM launchd sends at
  # logout. This trap is the entire "only while logged in" guarantee: no
  # session, no watcher, no disablesleep. Best-effort, because an exit path
  # must never fail; a SIGKILL or panic skips it and the next reconcile fixes
  # it at your next login.
  sudo -n "$PMSET" -a disablesleep 0 2>/dev/null || true
  log "watcher down — normal sleep restored"
}

cmd_watch() {
  trap cleanup EXIT INT TERM
  log "watcher up (pid $$)"

  # Plain polling, on purpose — not an oversight. `pmset -g pslog` looks like
  # the elegant answer but does not stream reliably under launchd (it exits
  # right after its header), and an event stream that dies quietly takes
  # disablesleep down with it. Two cheap pmset reads per tick cannot desync.
  # Closing the lid normally locks a Mac by putting it to sleep. When lich is
  # the reason it stays awake, macOS never fires that lock — measured, not
  # assumed: IOConsoleLocked stays false. So the watcher restores the
  # guarantee itself: on the tick where the lid goes shut while we hold the
  # machine awake, lock the console. Once per closure, not continuously — so
  # a deliberate unlock over Screen Sharing with the lid down isn't fought.
  # The lock is *requested*, then *verified* on the following tick — because
  # locking rides on the user's "require password after screen saver/display
  # off" setting, which lich cannot see and Tahoe has known regressions in.
  # One verdict per closure, logged honestly; no retry loop, so a deliberate
  # unlock over Screen Sharing with the lid down is never fought.
  LID_WAS_CLOSED=0
  LOCK_PENDING=0
  while :; do
    reconcile || exit $?   # broken sudoers = die loudly; launchd retries
    if [[ "$(sleep_disabled)" == "1" ]] && lid_closed; then
      if [[ "$LID_WAS_CLOSED" == 0 ]]; then
        if console_locked; then
          LOCK_PENDING=0
        else
          lock_console
          log "lid closed while risen — lock requested"
          LOCK_PENDING=1
        fi
        LID_WAS_CLOSED=1
      elif [[ "$LOCK_PENDING" == 1 ]]; then
        if console_locked; then
          log "lock confirmed"
        else
          log_warn "WARNING: lock did NOT take — an opened lid lands on your desktop. Check System Settings > Lock Screen: 'Require password after screen saver begins or display is turned off' (set it to 'Immediately')."
        fi
        LOCK_PENDING=0
      fi
    else
      LID_WAS_CLOSED=0
      LOCK_PENDING=0
    fi
    sleep "$POLL_INTERVAL"
  done
}

# ---------- user commands ---------------------------------------------------
# on/off only write the flag; the watcher is what makes it true. Hence the menu
# bar app, the Control Center toggle and an ssh one-liner are all equally valid
# front ends — they write the same file.

# Writing the flag and applying it now, without the announcement — `lich on`
# and every `lich roam` form need exactly this, and they say different things
# about it afterwards.
raise() {
  mkdir -p "$STATE_DIR"
  echo on > "$FLAG"
  # Apply now instead of waiting up to POLL_INTERVAL for the tick. Tolerate
  # failure (not installed yet): the flag is set, and the callers' warning
  # says what to do about it.
  reconcile || true
}

# Worth saying loudly: with no watcher, nothing will undo any of this on
# unplug, on a timer, or at the battery floor.
warn_no_watcher() {
  watcher_running || echo "warning: watcher not running — run: lich install" >&2
}

cmd_on() {
  raise
  log "cmd: on"
  echo "💀 lich risen — lid-close keeps this Mac awake while on AC power"
  warn_no_watcher
}

cmd_off() {
  mkdir -p "$STATE_DIR"
  echo off > "$FLAG"
  # Also restore sleep directly, so `lich off` is instant and works even with
  # no watcher. Best-effort: the flag is what matters.
  sudo -n "$PMSET" -a disablesleep 0 2>/dev/null || true
  log "cmd: off"
  echo "⚰️  lich at rest — normal sleep behavior restored"
}

# ---------- roaming commands ------------------------------------------------
# Every arming form also raises the lich: "keep me awake off the cord" is one
# intention, and making it two commands only invites the half-armed state
# where roam is set and the flag isn't. `off` and `status` never touch the
# risen flag — laying the lich to rest stays a separate, deliberate decision.

cmd_roam() {
  local arg="${1:-once}" mins floor epoch

  case "$arg" in
    # Read-only forms first, so nothing below can be reached by accident.
    status)
      # EXACTLY one bare line: the menu bar app parses this. No decoration,
      # no second line, no emoji — and no writes (see roam_state).
      roam_state
      return 0
      ;;
    off)
      roam_set off
      log "cmd: roam off"
      echo "roam off — unplugging lays the lich to rest again"
      return 0
      ;;
  esac

  floor="$(config_get floor "$DEFAULT_FLOOR")"
  case "$arg" in
    ""|once)
      roam_set once
      raise
      log "cmd: roam once"
      echo "💀 roaming once — risen without the phylactery until you plug back in (floor ${floor}%)"
      ;;
    always)
      roam_set always
      raise
      log "cmd: roam always"
      echo "💀 roaming always — unplugging no longer rests the lich (floor ${floor}% still does)"
      ;;
    timer)
      mins="$(config_get roam_mins "$DEFAULT_ROAM_MINS")"
      cmd_roam "$mins"
      return 0
      ;;
    *)
      # `lich roam 45` and `lich roam 45m` are the same request.
      if [[ "$arg" =~ ^([0-9]+)m?$ ]]; then
        mins="${BASH_REMATCH[1]}"
        [[ "$mins" -ge 1 ]] || die "roam: minutes must be 1 or more"
        epoch=$(( $(date +%s) + mins * 60 ))
        roam_set "until $epoch"
        raise
        log "cmd: roam ${mins}m (until $epoch)"
        echo "💀 roaming for ${mins} min — risen without the phylactery until $(date -r "$epoch" '+%H:%M') (floor ${floor}%)"
      else
        die "unknown roam mode: $arg (try: lich roam, roam always, roam <minutes>, roam timer, roam off, roam status)"
      fi
      ;;
  esac
  warn_no_watcher
}

# For an agent handing the machine back. It spends a trip it may have been
# given; it does not spend the owner's standing preference, and it never lays
# the lich to rest — `lich off` is a human decision about a human's Mac.
cmd_done() {
  case "$(roam_mode)" in
    once|'until '*)
      roam_set off
      log "cmd: done (roam cleared)"
      echo "roam cleared — this Mac may sleep again once unplugged (still risen; 'lich off' to rest)"
      ;;
    always)
      echo "roam is 'always' — left as is; clear it yourself with: lich roam off"
      ;;
    *)
      echo "roam already off — nothing to clear"
      ;;
  esac
}

# ---------- config ----------------------------------------------------------

cmd_config() {
  local key="${1:-}" val="${2:-}"
  case "$key" in
    "")
      # The *effective* config, defaults included — the menu bar app reads
      # roam_mins from here to label its timer item, so it must always answer.
      echo "floor=$(config_get floor "$DEFAULT_FLOOR")"
      echo "roam_mins=$(config_get roam_mins "$DEFAULT_ROAM_MINS")"
      ;;
    floor)
      [[ "$val" =~ ^[0-9]+$ ]] || die "config floor: need a whole number of percent (5-95)"
      # 5 is low enough to be reckless but not bricking; 95 keeps the setting
      # from being a way to disable roaming by accident.
      [[ "$val" -ge 5 && "$val" -le 95 ]] || die "config floor: must be between 5 and 95"
      config_set floor "$val"
      echo "floor=$val"
      ;;
    roam_mins)
      [[ "$val" =~ ^[0-9]+$ ]] || die "config roam_mins: need a whole number of minutes (1-1440)"
      [[ "$val" -ge 1 && "$val" -le 1440 ]] || die "config roam_mins: must be between 1 and 1440"
      config_set roam_mins "$val"
      echo "roam_mins=$val"
      ;;
    *)
      die "unknown config key: $key (known: floor, roam_mins)"
      ;;
  esac
}

cmd_status() {
  local quiet="${1:-}"
  # --quiet: no output, exit 0 when risen. The menu bar app polls this rather
  # than parsing the human block below.
  if [[ "$quiet" == "--quiet" || "$quiet" == "-q" ]]; then
    risen; exit $?
  fi
  if risen; then
    echo "lich:    💀 risen"
  else
    echo "lich:    ⚰️  at rest"
  fi
  echo "power:   $(power_source)"
  # Separate line from "lich:" because the two legitimately disagree: risen on
  # battery means this setting is off, and that is correct.
  if [[ "$(sleep_disabled)" == "1" ]]; then
    echo "sleep:   disabled — lid-close keeps the Mac awake"
  else
    echo "sleep:   normal — lid-close sleeps"
  fi
  # Roaming and the battery are two lines, not one, for the same reason as
  # above: they legitimately disagree. "roam: always" with the battery under
  # the floor is a suspended preference, not a contradiction.
  local floor; floor="$(config_get floor "$DEFAULT_FLOOR")"
  read_battery
  echo "roam:    $(roam_human)"
  echo "battery: ${BATTERY_PCT}% (floor ${floor}%)"
  watcher_running && echo "watcher: running" || echo "watcher: NOT running (run: lich install)"
  if ! risen; then
    echo
    echo "raise it: lich on    (stays awake with the lid closed while plugged in)"
  elif ! on_ac; then
    echo
    if [[ "$(roam_state)" == "off" ]]; then
      echo "note: on battery — the lich rests until the phylactery (AC power) returns"
      echo "      (or roam: lich roam — stay risen unplugged, down to the floor)"
    elif [[ "$BATTERY_PCT" -le "$floor" ]]; then
      echo "note: below the battery floor — roaming is off until you charge past it"
    else
      echo "note: roaming — risen without the phylactery; 'lich done' when the work is finished"
    fi
  fi
}

# Copy a built Lich.app into /Applications and (re)launch it. The app must
# live at a stable path: it registers itself as a login item, and a pointer
# into a versioned Cellar directory dies on the next upgrade. Sources, in
# order: the brew prefix (the formula builds the app at install time, on this
# machine, so its ad-hoc signature is trusted here) or a clone's menubar/
# build. Quiet; returns 0 synced, 1 nothing to sync, 2 copy failed.
sync_menubar_app() {
  local self="$1" src=""
  if [[ -d "${self%/bin/lich}/Lich.app" ]]; then
    src="${self%/bin/lich}/Lich.app"
  elif [[ -d "$(dirname "$self")/menubar/Lich.app" ]]; then
    src="$(dirname "$self")/menubar/Lich.app"
  else
    return 1
  fi
  pkill -f lich-menubar 2>/dev/null
  rm -rf /Applications/Lich.app 2>/dev/null
  cp -R "$src" /Applications/Lich.app 2>/dev/null || return 2
  open /Applications/Lich.app 2>/dev/null
  return 0
}

cmd_install() {
  local self tmp

  # Which copy of this script does launchd run forever? Resolve symlinks, so
  # the plist records a real file rather than a link that may be repointed.
  self="$(/usr/bin/readlink -f "$0" 2>/dev/null || echo "$0")"
  # ...except under Homebrew, where that real file sits in a *versioned* Cellar
  # path (.../Cellar/lichbook/0.1.2/bin/lich) which disappears on the next
  # `brew upgrade`, leaving launchd aimed at nothing. Rewrite to brew's opt/
  # symlink, which brew repoints at each version and is stable across upgrades.
  # Prefix-relative, so it holds on /opt/homebrew and /usr/local alike.
  if [[ "$self" == */Cellar/lichbook/* ]]; then
    self="${self%%/Cellar/*}/opt/lichbook/bin/lich"
  fi

  # ---- fail-open zone -------------------------------------------------------
  # Policy: only the current latest macOS is tested. Anywhere else, a partial
  # install is an EXPECTED outcome, not an error to abort on — so from here to
  # the summary, no step may end the run. Each step is attempted on its own,
  # failures warn and continue, and the summary tells the truth about what
  # works. Exit status: 0 unless the load-bearing sudoers step failed.
  set +e

  local st_sudoers=failed st_link=failed st_flag=failed st_plist=failed st_agent=failed
  local st_app=skipped note_app=""
  local note_sudoers="" note_link="" note_flag="" note_plist="" note_agent="" have_sudo=0 i=0

  # Say it out loud first, in the order it happens. Anyone about to type their
  # password deserves the list.
  echo "This sets up (one sudo prompt):"
  echo "  1. $SUDOERS — passwordless sudo for EXACTLY two commands:"
  echo "       pmset -a disablesleep 0   and   pmset -a disablesleep 1"
  echo "  2. lich on your PATH (skipped if it already is, e.g. via Homebrew)"
  echo "  3. $FLAG (risen/at-rest flag, starts at rest)"
  echo "  4. $PLIST (per-user LaunchAgent, runs as you, loaded now)"
  echo "  5. /Applications/Lich.app (menu bar 💀 — if a built copy is available)"
  echo

  # One credential prompt, up front. Declined or unavailable = the privileged
  # steps below are skipped in one go instead of re-prompting at each.
  sudo -v && have_sudo=1

  # 1. The scoped sudoers rule (the load-bearing step). Validated with
  #    `visudo -cf` BEFORE it goes live — a syntax error in a live sudoers
  #    file can break sudo machine-wide. Then PROVED, not assumed: the probe
  #    runs the exact call the watcher will make every 5s forever. `-k` first
  #    drops the credential `sudo -v` just cached (without it the probe passes
  #    on a machine with no rule at all); re-applying the current live value
  #    makes the probe a visible no-op.
  if [[ "$have_sudo" == 1 ]]; then
    tmp="$(mktemp)"
    cat > "$tmp" <<EOF
# lichbook: allow toggling lid-close sleep without a password.
# Scoped to exactly these two commands — nothing else.
$USER ALL=(root) NOPASSWD: $PMSET -a disablesleep 0, $PMSET -a disablesleep 1
EOF
    if ! sudo /usr/sbin/visudo -cf "$tmp" >/dev/null 2>&1; then
      note_sudoers="generated rule failed visudo validation — nothing was written"
    elif ! sudo install -o root -g wheel -m 0440 "$tmp" "$SUDOERS" 2>/dev/null; then
      note_sudoers="could not write $SUDOERS"
    else
      sudo -k
      if sudo -n "$PMSET" -a disablesleep "$(sleep_disabled)" 2>/dev/null; then
        st_sudoers=ok
      else
        note_sudoers="rule written but the passwordless probe failed"
      fi
    fi
    rm -f "$tmp"
  else
    st_sudoers=skipped note_sudoers="no sudo credential"
  fi
  [[ "$st_sudoers" == ok ]] || echo "lich: warning: sudoers: $note_sudoers" >&2

  # 2. Put `lich` on PATH — only if it isn't already. Homebrew owns its own
  #    symlink and clobbering it would leave brew managing a file it no longer
  #    controls; this branch really means "running from a clone".
  if command -v lich >/dev/null 2>&1; then
    st_link=skipped note_link="already on PATH"
  elif [[ "$have_sudo" == 1 ]] && sudo mkdir -p "$(dirname "$CLI_LINK")" 2>/dev/null \
       && sudo ln -sf "$self" "$CLI_LINK" 2>/dev/null; then
    st_link=ok
  else
    note_link="could not create $CLI_LINK — run it as: $self"
    echo "lich: warning: PATH: $note_link" >&2
  fi

  # 3. State flag, at rest. An existing choice is left alone, so reinstalling
  #    or upgrading never changes what your Mac is doing.
  if mkdir -p "$STATE_DIR" 2>/dev/null && { [[ -f "$FLAG" ]] || echo off > "$FLAG"; } 2>/dev/null; then
    st_flag=ok
  else
    note_flag="could not create $FLAG — on/off (and the toggles) cannot record state"
    echo "lich: warning: state: $note_flag" >&2
  fi

  # 4a. The LaunchAgent plist, aimed at the $self resolved above. Per-user
  #     (gui/$UID) rather than a root LaunchDaemon — that choice is what ties
  #     its lifetime to your login session. Written even when earlier steps
  #     failed: it is a plain file in your own home, and having it on disk is
  #     what makes a re-run or a manual bootstrap recoverable.
  if mkdir -p "$(dirname "$PLIST")" "$(dirname "$LOG_FILE")" 2>/dev/null; then
    cat > "$PLIST" 2>/dev/null <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$self</string>
        <string>watch</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>$LOG_FILE</string>
    <key>StandardErrorPath</key><string>$LOG_FILE</string>
</dict>
</plist>
EOF
    [[ -s "$PLIST" ]] && st_plist=ok || note_plist="could not write $PLIST"
  else
    note_plist="could not create $(dirname "$PLIST")"
  fi
  [[ "$st_plist" == ok ]] || echo "lich: warning: plist: $note_plist" >&2

  # 4b. Load it — but ONLY with a proven sudoers rule. Without one the watcher
  #     exits EX_CONFIG on its first tick and KeepAlive respawns it forever:
  #     an ERROR line in the log every ~10s until someone notices. Skipping is
  #     kinder than that loop. Liveness is measured by polling the agent, not
  #     by trusting launchctl's exit status, which lies here.
  if [[ "$st_sudoers" != ok ]]; then
    st_agent=skipped note_agent="not loaded — sudoers rule not working"
  elif [[ "$st_plist" != ok ]]; then
    st_agent=skipped note_agent="not loaded — no plist"
  else
    launchctl enable "gui/$UID/$LABEL" 2>/dev/null
    launchctl bootstrap "gui/$UID" "$PLIST" 2>/dev/null || launchctl kickstart -k "gui/$UID/$LABEL" 2>/dev/null
    i=0
    while [[ "$i" -lt 10 ]]; do
      watcher_running && break
      sleep 0.2; i=$((i + 1))
    done
    if watcher_running; then
      st_agent=ok
    else
      note_agent="agent did not come up — see $LOG_FILE"
      echo "lich: warning: agent: $note_agent" >&2
    fi
  fi

  # 5. The menu bar app, when a built copy exists (the brew formula builds one
  #    into its prefix; a clone has one after `make -C menubar`). Optional and
  #    unprivileged — /Applications is admin-writable without sudo.
  case "$(sync_menubar_app "$self"; echo $?)" in
    0) st_app=ok ;;
    1) note_app="no built app found (from a clone: make -C menubar, then re-run)" ;;
    *) st_app=failed note_app="could not copy into /Applications"
       echo "lich: warning: menu bar app: $note_app" >&2 ;;
  esac

  # ---- summary (the only way install ends) ----------------------------------
  echo
  echo "install summary:"
  printf '  %-8s sudoers rule%s\n'  "$st_sudoers" "${note_sudoers:+ — $note_sudoers}"
  printf '  %-8s PATH link%s\n'     "$st_link"    "${note_link:+ — $note_link}"
  printf '  %-8s state flag%s\n'    "$st_flag"    "${note_flag:+ — $note_flag}"
  printf '  %-8s watcher plist%s\n' "$st_plist"   "${note_plist:+ — $note_plist}"
  printf '  %-8s watcher agent%s\n' "$st_agent"   "${note_agent:+ — $note_agent}"
  printf '  %-8s menu bar app%s\n'  "$st_app"     "${note_app:+ — $note_app}"
  echo
  if [[ "$st_sudoers" == ok && "$st_agent" == ok ]]; then
    echo "All set. Raise it with: lich on"
  elif [[ "$st_sudoers" == ok ]]; then
    echo "The CLI works right now — lich on/off apply the setting directly."
    echo "But with NO watcher, nothing reverts it for you: unplugging will NOT"
    echo "restore sleep, logout will NOT restore sleep, roam timers and the"
    echo "battery floor do NOT run. For real protection keep 'lich watch'"
    echo "running in a terminal or tmux, and re-run 'lich install' after"
    echo "fixing the agent (start with $LOG_FILE)."
  else
    echo "Not functional yet: nothing can change the sleep setting, so"
    echo "lid-close still sleeps normally. 'lich status' and the flag files"
    echo "work; fix the rule and re-run 'lich install', or add it by hand"
    echo "with 'sudo visudo -f $SUDOERS':"
    echo "  $USER ALL=(root) NOPASSWD: $PMSET -a disablesleep 0, $PMSET -a disablesleep 1"
  fi
  echo "(The Control Center toggle is a separate, optional source build — see README.)"

  log "cmd: install (sudoers=$st_sudoers link=$st_link flag=$st_flag plist=$st_plist agent=$st_agent app=$st_app)"
  set -e
  [[ "$st_sudoers" == ok ]]
}

# ---------- Control Center widget (optional, explicit, heavyweight) ---------
# The one component with a real toolchain requirement: appex targets cannot be
# built with Command Line Tools alone, so this needs full Xcode plus xcodegen.
# It is therefore never part of `lich install` — it is an explicit ask, and
# without the toolchain it warns and does nothing rather than half-installing.
cmd_widget() {
  local arg="${1:-add}" self src tmpdir
  case "$arg" in
    remove)
      pkill -f LichToggle 2>/dev/null || true
      rm -rf /Applications/LichToggle.app
      log "cmd: widget remove"
      echo "Control Center widget removed (macOS may keep a stale gallery entry until next login)"
      return 0
      ;;
    add) ;;
    *) die "usage: lich widget [remove]" ;;
  esac

  # Toolchain gates, clearest message first, nothing touched on failure.
  if ! /usr/bin/xcodebuild -version >/dev/null 2>&1; then
    die "cannot add the Control Center widget without full Xcode — the Command
      Line Tools are not enough. Install Xcode (App Store), then:
        sudo xcode-select -s /Applications/Xcode.app/Contents/Developer
      and re-run: lich widget"
  fi
  command -v xcodegen >/dev/null 2>&1 \
    || die "cannot add the widget without xcodegen: brew install xcodegen — then re-run: lich widget"

  # Sources: the brew formula keeps a copy in its prefix; a clone has them
  # sitting next to this script.
  self="$(/usr/bin/readlink -f "$0" 2>/dev/null || echo "$0")"
  [[ "$self" == */Cellar/lichbook/* ]] && self="${self%%/Cellar/*}/opt/lichbook/bin/lich"
  if [[ -d "${self%/bin/lich}/controlcenter" ]]; then
    src="${self%/bin/lich}/controlcenter"
  elif [[ -d "$(dirname "$self")/controlcenter" ]]; then
    src="$(dirname "$self")/controlcenter"
  else
    die "widget sources not found — reinstall lichbook, or run from a clone"
  fi

  # Build in a scratch copy, never inside the brew prefix; build.sh signs
  # ad-hoc on this machine, installs /Applications/LichToggle.app, launches it
  # to register the extension, and prints the gallery-refresh steps.
  tmpdir="$(mktemp -d)"
  cp -R "$src" "$tmpdir/controlcenter"
  echo "building the Control Center widget (a first build can take a minute)…"
  if ( cd "$tmpdir/controlcenter" && ./build.sh ); then
    rm -rf "$tmpdir"
    log "cmd: widget add"
  else
    rm -rf "$tmpdir"
    die "widget build failed — scroll up for the first error"
  fi
}

cmd_upgrade() {
  # One update command for both install styles. Detect which this is from
  # where the script actually lives: brew keeps it under Cellar/opt, a clone
  # is a git worktree. Then refresh the /Applications app from whatever the
  # update produced and restart the watcher onto the new code.
  local self dir
  self="$(/usr/bin/readlink -f "$0" 2>/dev/null || echo "$0")"
  log "cmd: upgrade"
  case "$self" in
    */Cellar/lichbook/*|*/opt/lichbook/*)
      echo "Homebrew install — updating via brew…"
      # `brew update` refreshes the tap (the formula lives in the repo, so a
      # new release is invisible until the tap is pulled).
      brew update >/dev/null 2>&1 || true
      brew upgrade lichbook 2>&1 || echo "(already up to date)"
      # The old Cellar dir this process resolved from may be gone now — use
      # the stable opt path for everything after this point.
      self="${self%%/Cellar/*}/opt/lichbook/bin/lich"
      [[ "$self" == */opt/lichbook/* ]] || self="$(command -v lich || echo "$0")"
      ;;
    *)
      dir="$(dirname "$self")"
      if git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
        echo "Clone install — pulling…"
        git -C "$dir" pull --ff-only || die "git pull failed — resolve by hand in $dir"
        # Rebuild the menu bar app if the toolchain is here; fail open if not.
        command -v swiftc >/dev/null 2>&1 && make -C "$dir/menubar" >/dev/null 2>&1
      else
        die "can't tell how this was installed (not brew, not a git clone) — update by hand"
      fi
      ;;
  esac
  if sync_menubar_app "$self"; then
    echo "menu bar app refreshed"
  fi
  if launchctl kickstart -k "gui/$UID/$LABEL" 2>/dev/null; then
    echo "watcher reloaded — running the new code"
  else
    echo "watcher not loaded (run: lich install)" >&2
  fi
}

# The evidence trail, on demand. Every state change from every front end lands
# in one file; this is how state-table rows graduate from Should-work to
# Tested — do the thing, then read what actually happened.
cmd_log() {
  local n="${1:-25}"
  [[ "$n" =~ ^[0-9]+$ ]] || die "usage: lich log [lines]"
  [[ -f "$LOG_FILE" ]] || die "no log yet at $LOG_FILE"
  tail -n "$n" "$LOG_FILE"
}

cmd_reload() {
  # Restart the watcher so it picks up updated code — the running process is
  # still the old script, so `brew upgrade lichbook` alone changes nothing.
  # No sudo and no reinstall needed: the plist itself is unchanged.
  if launchctl kickstart -k "gui/$UID/$LABEL" 2>/dev/null; then
    echo "watcher reloaded"
  else
    die "watcher not loaded — run: lich install"
  fi
}

cmd_uninstall() {
  # Order matters: rest the flag and stop the watcher, restore normal sleep
  # while we still have the sudoers rule, and only then remove it. Every step
  # is best-effort so a half-installed machine can still be cleaned up.
  log "cmd: uninstall"
  echo off > "$FLAG" 2>/dev/null || true
  launchctl bootout "gui/$UID/$LABEL" 2>/dev/null || true
  sudo -n "$PMSET" -a disablesleep 0 2>/dev/null || true
  rm -f "$PLIST"
  rm -rf "$STATE_DIR"
  # The apps lich put there: the menu bar app (install step 5) and the
  # Control Center widget (`lich widget`), if present.
  pkill -f lich-menubar 2>/dev/null || true
  rm -rf /Applications/Lich.app 2>/dev/null || true
  pkill -f LichToggle 2>/dev/null || true
  rm -rf /Applications/LichToggle.app 2>/dev/null || true
  sudo rm -f "$SUDOERS"
  # The PATH entry — but only if WE made it. On an Intel Mac the Homebrew
  # prefix is also /usr/local, so brew's own symlink (which points into the
  # Cellar) lives at this exact path; that one is brew uninstall's to remove.
  if [[ -L "$CLI_LINK" && "$(readlink "$CLI_LINK")" != *"/Cellar/"* ]]; then
    sudo rm -f "$CLI_LINK"
  fi
  echo "lich uninstalled — the Mac is mortal again"
}

cmd_help() {
  cat <<'EOF'
lich — your MacBook, undead. Lid closed, plugged in, still working.

usage: lich [command]     (bare `lich` = status)

  on         raise: stay awake with lid closed while on AC power
  off        rest: normal sleep behavior
  status     show risen state, power source, sleep setting, roam mode,
             battery vs. floor, watcher health
             -q, --quiet  print nothing; exit 0 if risen, non-zero if at rest
  log [n]    last n log lines (default 25) — every state change from every
             front end, timestamped; the evidence trail
  roam       stay risen unplugged for one trip, and raise if at rest
             roam always   every unplug, until you turn it off
             roam <N>      for N minutes (45 or 45m); also: roam timer,
                           which uses the configured roam_mins
             roam off      stop roaming (leaves the risen flag alone)
             roam status   one bare line: off | once | always | until <epoch>
  done       for agents: clear a once/timed roam now the work is finished.
             Never touches 'always' (the owner's preference, not yours) and
             never lays the lich to rest
  config     print effective settings as key=value (floor, roam_mins)
             config floor <5-95>        battery % where roaming ends
             config roam_mins <1-1440>  what 'roam timer' means
  install    one-time setup, prompts for sudo once: sudoers rule scoped to
             two pmset commands, ~/.lich state flag, LaunchAgent watcher, and
             /usr/local/bin/lich unless lich is already on PATH
  widget     build + add the optional Control Center toggle — needs full
             Xcode and xcodegen; warns and does nothing without them
             widget remove  take it back out
  upgrade    update lich (brew or git clone, auto-detected), refresh the
             menu bar app, and reload the watcher — the whole update, one word
  reload     restart the watcher only (upgrade runs this for you)
  uninstall  remove all of that and restore normal sleep
  watch      internal: the launchd watcher loop, not for hand use
  help       this text

While risen: plugged in + logged in = never sleeps, lid open or closed.
On battery, or logged out, or at rest: sleeps like a normal Mac.
The power cord is the phylactery — sever it and the lich rests, unless you
asked to roam.

Roaming is the one exception, and it has a hard floor: at or below the
battery floor (20% by default) roaming ends — a once/timed roam is canceled,
an 'always' roam is suspended until you charge past it. There is no override.

The flag lives in ~/.lich/desired-state ("on"/"off") — the menu bar app and
Control Center toggle flip the same flag, and the watcher acts on it within
about 5 seconds. Roaming lives beside it in ~/.lich/roam and ~/.lich/config.
Log: ~/Library/Logs/lich.log
EOF
}

# Bare `lich` is status — the safe, read-only default.
case "${1:-status}" in
  on)        cmd_on ;;
  off)       cmd_off ;;
  status)    cmd_status "${2:-}" ;;
  log)       cmd_log "${2:-}" ;;
  roam)      cmd_roam "${2:-}" ;;
  done)      cmd_done ;;
  config)    cmd_config "${2:-}" "${3:-}" ;;
  watch)     cmd_watch ;;
  install)   cmd_install ;;
  widget)    cmd_widget "${2:-}" ;;
  upgrade)   cmd_upgrade ;;
  reload)    cmd_reload ;;
  uninstall) cmd_uninstall ;;
  help|-h|--help) cmd_help ;;
  *) die "unknown command: $1 (try: lich help)" ;;
esac
